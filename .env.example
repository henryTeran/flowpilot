APP_NAME=FlowPilot Institut Manager
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://flowpilot:flowpilot@postgres:5432/flowpilot_flow
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_CREATE_SCHEMA_ON_STARTUP=true
ENABLE_SECURITY_HEADERS=true
# AI ports are disabled by default; Compose exports this env_file to the server.
# Direct uvicorn: export FLOWPILOT_AI_* in the server process environment.
FLOWPILOT_AI_LLM_PROVIDER=disabled
FLOWPILOT_AI_STT_PROVIDER=disabled
FLOWPILOT_AI_EMBEDDING_PROVIDER=disabled
FLOWPILOT_AI_TIMEOUT_MS=15000
FLOWPILOT_AI_LLM_MODEL=
FLOWPILOT_AI_STT_MODEL=
FLOWPILOT_AI_EMBEDDING_MODEL=
FLOWPILOT_AI_OPENAI_API_KEY=
FLOWPILOT_AI_MISTRAL_API_KEY=
